# 서버 포트
PORT=5000
# development | production
NODE_ENV=development
# MongoDB 연결 문자열 (로컬 또는 Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/momori
# 허용할 프론트엔드 주소 (쉼표로 여러 개 가능)
CLIENT_ORIGIN=http://localhost:5173
# JWT 서명 키 (길고 무작위인 문자열로 변경, 예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-this-to-a-long-random-string
# 로그인 유지 기간 (기본 1일, "로그인 상태 유지" 체크 시 30일은 코드에서 고정)
JWT_EXPIRES_IN=1d

# Cloudinary 이미지 저장소 (https://console.cloudinary.com → Settings → API Keys)
# 세 값을 모두 넣으면 Cloudinary에, 비워 두면 서버 로컬(server/uploads)에 저장
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# 업로드 폴더 (기본: momori → momori/products/...)
CLOUDINARY_FOLDER=momori
